[Unit]
Description=Fushengliunian durable generation workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fushengliunian/backend
EnvironmentFile=/etc/fushengliunian/backend.env
ExecStart=/opt/fushengliunian-runtime/venv/bin/python -m app.worker
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
